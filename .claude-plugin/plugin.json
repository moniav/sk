{
  "$schema": "https://json.schemastore.org/claude-code-plugin.json",
  "name": "sk",
  "displayName": "SK — ShipKit",
  "description": "Documentation & lifecycle system for Claude Code — Plan/Dev/Test lifecycle with 53 commands, 23 skills, and 9 agents. EXPERIMENTAL plugin channel: the docs/ scaffold still requires 'npx shipkit-cld', and some in-command file references assume a project install. The npm channel remains primary.",
  "author": {
    "name": "moniav",
    "url": "https://github.com/moniav"
  },
  "homepage": "https://github.com/moniav/sk#readme",
  "repository": "https://github.com/moniav/sk",
  "license": "MIT",
  "keywords": [
    "documentation",
    "lifecycle",
    "plan-dev-test",
    "code-review",
    "agents",
    "autonomy"
  ],
  "commands": "./pkg/.claude/commands/sk",
  "agents": [
    "./pkg/.claude/agents/architecture-reviewer.md",
    "./pkg/.claude/agents/debugger.md",
    "./pkg/.claude/agents/dependency-analyzer.md",
    "./pkg/.claude/agents/implementer.md",
    "./pkg/.claude/agents/perf-reviewer.md",
    "./pkg/.claude/agents/plan-reviewer.md",
    "./pkg/.claude/agents/quality-reviewer.md",
    "./pkg/.claude/agents/security-reviewer.md",
    "./pkg/.claude/agents/spec-reviewer.md"
  ],
  "skills": "./pkg/.claude/skills"
}
