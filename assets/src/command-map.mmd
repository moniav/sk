flowchart TB
    subgraph flow [" "]
        direction LR
        GS["<b>Start</b><br/>/sk:help<br/>/sk:kickoff<br/>/sk:init-docs<br/>/sk:brainstorm"]
        CR["<b>Create work</b><br/>/sk:new-epic<br/>/sk:new-task"]
        LC["<b>Build</b><br/>/sk:plan, /sk:dev, /sk:test<br/>/sk:implement (all three)<br/>/sk:orchestrate (parallel)"]
        QA["<b>Review</b><br/>/sk:review (all at once)<br/>/sk:code-review<br/>/sk:security-review<br/>/sk:perf-review<br/>/sk:ui-review<br/>/sk:recap"]
        SH["<b>Ship</b><br/>/sk:finish<br/>/sk:commit, /sk:pr<br/>/sk:changelog, /sk:release<br/>/sk:announce"]
        GS --> CR --> LC --> QA --> SH
    end

    subgraph anytime [" "]
        direction LR
        FX["<b>Fix and change</b><br/>/sk:debug<br/>/sk:refactor<br/>/sk:migrate<br/>/sk:deps, /sk:debt"]
        SE["<b>Session and upkeep</b><br/>/sk:resume<br/>/sk:task-status<br/>/sk:retro<br/>/sk:routines<br/>/sk:update"]
        DO["<b>Docs</b><br/>/sk:update-docs<br/>/sk:docs-audit<br/>/sk:new-feature-doc<br/>/sk:new-user-guide<br/>/sk:new-sop, /sk:new-flow"]
        DE["<b>Decide</b><br/>/sk:council<br/>/sk:new-adr"]
        RU["<b>Run and comply</b><br/>/sk:ops<br/>/sk:legal-scan"]
        GT["<b>Go to market</b><br/>/sk:positioning<br/>/sk:competitor<br/>/sk:pricing<br/>/sk:copywrite<br/>/sk:campaign<br/>/sk:new-business-doc"]
        EX["<b>Executive team</b><br/>/sk:ceo, /sk:cto<br/>/sk:cmo, /sk:coo<br/>/sk:founder"]
        FX ~~~ SE ~~~ DO ~~~ DE ~~~ RU ~~~ GT ~~~ EX
    end

    flow ~~~ anytime

    style flow fill:none,stroke:none
    style anytime fill:none,stroke:none
